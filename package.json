    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "sass": "^1.102.0",
    "sharp": "^0.35.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"

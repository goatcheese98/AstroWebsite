---
import PageLayout from "../layouts/PageLayout.astro";
import Hero from "../components/sections/Hero.astro";
import Projects from "../components/sections/Projects.astro";
import Experience from "../components/sections/Experience.astro";
import SystemsToolkit from "../components/sections/SystemsToolkit.astro";
---

<PageLayout
  title="AI Product & Systems Builder"
  description="Rohan Jasani turns operational friction into reliable AI systems teams actually use, from workflow discovery and product delivery through adoption and operation."
>
  <div class="landing-page">
    <Hero />
    <Experience />
    <Projects />
    <SystemsToolkit />
  </div>
</PageLayout>

<style>
  .landing-page {
    position: relative;
    background: transparent;
  }

  .landing-page :global(.gradient-text) {
    color: var(--color-text);
    background: none;
    -webkit-background-clip: unset;
    background-clip: unset;
    -webkit-text-fill-color: currentColor;
  }

  .landing-page :global(.section-header__line) {
    background: #ffd600;
  }

  .landing-page :global(.section-gap) {
    padding-block: clamp(1.5rem, 4vw, 2.75rem);
  }

  .landing-page :global(.projects) {
    padding-top: clamp(3.5rem, 7vw, 5.5rem);
  }
</style>

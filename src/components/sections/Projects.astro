---
import type { Project } from "../../types";
import { PROJECTS } from "../../lib/constants";
import SectionHeader from "../ui/SectionHeader.astro";

const featuredProject = PROJECTS.find((project) => project.featured) ?? PROJECTS[0];
const supportingProjects = PROJECTS.filter((project) => project !== featuredProject);

const projectLink = (project: Project) => project.demoUrl ?? project.codeUrl;
const projectAction = (project: Project) => project.demoUrl ? "View project" : "View code";
---

<section class="projects section-gap" id="projects" aria-label="Selected work">
  <div class="container projects__container">
    <SectionHeader
      title="Selected Work"
      subtitle="Products and systems built to make complicated work clearer."
    />

    <article
      class="project-card project-card--featured"
      style={`--project-accent: ${featuredProject.accentColor ?? "#3b82f6"}`}
    >
      <div class="project-card__marker" aria-hidden="true">
        <span>01</span>
        <span>Flagship build</span>
      </div>

      <div class="project-card__body">
        <div class="project-card__copy">
          <p class="project-card__eyebrow">AI-native workspace</p>
          <h3>{featuredProject.title}</h3>
          <p class="project-card__description">{featuredProject.description}</p>
        </div>

        <div class="project-card__meta">
          <ul class="project-card__tags" aria-label={`${featuredProject.title} capabilities`}>
            {featuredProject.tags.map((tag) => <li>{tag}</li>)}
          </ul>

          {projectLink(featuredProject) && (
            <a
              class="project-action project-action--primary"
              href={projectLink(featuredProject)}
              target="_blank"
              rel="noopener"
            >
              {projectAction(featuredProject)}
              <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      </div>
    </article>

    <div class="project-list" role="list" aria-label="More selected work">
      {supportingProjects.map((project, index) => (
        <article
          class="project-card project-card--supporting"
          style={`--project-accent: ${project.accentColor ?? "#ffd600"}`}
          role="listitem"
        >
          <div class="project-card__marker" aria-hidden="true">
            <span>{String(index + 2).padStart(2, "0")}</span>
            <span>{project.demoUrl ? "Live project" : "Open source"}</span>
          </div>

          <div class="project-card__copy">
            <h3>{project.title}</h3>
            <p class="project-card__description">{project.description}</p>
          </div>

          <div class="project-card__meta">
            <ul class="project-card__tags" aria-label={`${project.title} capabilities`}>
              {project.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
            </ul>

            {projectLink(project) && (
              <a
                class="project-action project-action--secondary"
                href={projectLink(project)}
                target="_blank"
                rel="noopener"
              >
                {projectAction(project)}
                <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .projects__container {
    max-width: 1120px;
  }

  .projects :global(.section-header) {
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .project-card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
    padding: clamp(1.15rem, 3vw, 1.75rem);
    border: 1px solid color-mix(in srgb, var(--color-stroke-muted) 72%, transparent);
    border-radius: var(--radius-md);
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-surface) 96%, var(--project-accent) 4%);
  }

  .project-card::before {
    position: absolute;
    z-index: -1;
    inset: -2px;
    border: 2px solid var(--color-stroke);
    border-radius: inherit;
    content: "";
    filter: url(#sketch-filter);
    pointer-events: none;
  }

  .project-card::after {
    position: absolute;
    z-index: -1;
    top: 0;
    bottom: 0;
    left: 0;
    width: 5px;
    border-radius: var(--radius-md) 0 0 var(--radius-md);
    background: var(--project-accent);
    content: "";
  }

  .project-card--featured {
    margin-bottom: 1rem;
    padding: clamp(1.35rem, 4vw, 2.25rem);
    background:
      linear-gradient(
        105deg,
        color-mix(in srgb, var(--project-accent) 11%, var(--color-surface)),
        var(--color-surface) 58%
      );
    box-shadow: 7px 7px 0 color-mix(in srgb, var(--color-stroke) 90%, transparent);
  }

  .project-card__marker {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--color-stroke-muted);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .project-card__marker span:first-child {
    color: var(--project-accent);
  }

  .project-card__body,
  .project-card__meta {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .project-card__copy {
    flex: 1;
    min-width: 0;
  }

  .project-card__eyebrow {
    margin-bottom: 0.55rem;
    color: var(--project-accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .project-card h3 {
    margin-bottom: 0.65rem;
    color: var(--color-text);
    font-family: var(--font-hand);
    font-size: clamp(1.35rem, 3vw, 1.85rem);
    font-weight: 700;
    line-height: 1.15;
  }

  .project-card--featured h3 {
    font-size: clamp(2rem, 5vw, 3.1rem);
  }

  .project-card__description {
    max-width: 60ch;
    color: var(--color-text-muted);
    font-size: clamp(0.94rem, 1.8vw, 1.05rem);
    line-height: 1.65;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .project-card__tags li {
    padding: 0.35rem 0.62rem;
    border: 1px solid var(--color-stroke-muted);
    border-radius: 999px;
    color: var(--color-text-secondary);
    background: color-mix(in srgb, var(--color-bg) 80%, transparent);
    font-family: var(--font-mono);
    font-size: 0.69rem;
    line-height: 1.2;
  }

  .project-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    gap: 0.55rem;
    min-height: 44px;
    padding: 0.68rem 0.9rem;
    border: 2px solid var(--color-stroke);
    border-radius: 0.45rem;
    color: var(--color-text);
    background: var(--color-bg);
    box-shadow: 3px 3px 0 var(--color-stroke);
    font-family: var(--font-ui);
    font-size: 0.88rem;
    font-weight: 750;
    line-height: 1;
    text-decoration: none;
    transition: transform 150ms ease, box-shadow 150ms ease, background-color 150ms ease;
  }

  .project-action:hover {
    color: #0d0d12;
    background: #ffd600;
    box-shadow: 1px 1px 0 var(--color-stroke);
    text-decoration: none;
    transform: translate(2px, 2px);
  }

  .project-action:focus-visible {
    outline: 3px solid var(--project-accent);
    outline-offset: 4px;
  }

  .project-action--primary {
    color: #ffd600;
    background: #0d0d12;
  }

  .project-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }

  .project-card--supporting .project-card__meta {
    margin-top: auto;
  }

  @media (min-width: 720px) {
    .project-card__body {
      display: grid;
      grid-template-columns: minmax(0, 1.55fr) minmax(15rem, 0.75fr);
      align-items: end;
      gap: 2rem;
    }

    .project-card--featured .project-card__meta {
      align-items: flex-start;
      padding-left: 1.5rem;
      border-left: 1px solid var(--color-stroke-muted);
    }

    .project-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .project-list {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .project-card--supporting {
      grid-column: span 7;
      min-height: 21rem;
    }

    .project-card--supporting:nth-child(2),
    .project-card--supporting:nth-child(3) {
      grid-column: span 5;
      min-height: 19rem;
    }

    .project-card--supporting:nth-child(4) {
      grid-column: span 7;
      min-height: 19rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-action {
      transition: none;
    }
  }
</style>

---
import type { Project } from "../../types";
import { PROJECTS } from "../../lib/constants";
import SectionHeader from "../ui/SectionHeader.astro";

const featuredProject = PROJECTS.find((project) => project.featured) ?? PROJECTS[0];
const supportingProjects = PROJECTS.filter((project) => project !== featuredProject);

const projectLink = (project: Project) => project.demoUrl ?? project.codeUrl;
const projectAction = (project: Project) => project.demoUrl ? "View project" : "View code";
---

<section class="projects section-gap" id="projects" aria-label="Selected work">
  <div class="container projects__container">
    <SectionHeader
      title="Selected Work"
      subtitle="Products and systems built to make complicated work clearer."
    />

    <article
      class="project-card project-card--featured"
      style={`--project-accent: ${featuredProject.accentColor ?? "#3b82f6"}`}
    >
      <div class="project-card__marker" aria-hidden="true">
        <span>01</span>
        <span>Flagship build</span>
      </div>

      <div class="project-card__body">
        <div class="project-card__copy">
          <p class="project-card__eyebrow">AI-native workspace</p>
          <h3>{featuredProject.title}</h3>
          <p class="project-card__description">{featuredProject.description}</p>
        </div>

        <div class="project-card__meta">
          <ul class="project-card__tags" aria-label={`${featuredProject.title} capabilities`}>
            {featuredProject.tags.map((tag) => <li>{tag}</li>)}
          </ul>

          {projectLink(featuredProject) && (
            <a
              class="project-action project-action--primary"
              href={projectLink(featuredProject)}
              target="_blank"
              rel="noopener"
            >
              {projectAction(featuredProject)}
              <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      </div>
    </article>

    <div class="project-list" role="list" aria-label="More selected work">
      {supportingProjects.map((project, index) => (
        <article
          class="project-card project-card--supporting"
          style={`--project-accent: ${project.accentColor ?? "#ffd600"}`}
          role="listitem"
        >
          <div class="project-card__marker" aria-hidden="true">
            <span>{String(index + 2).padStart(2, "0")}</span>
            <span>{project.demoUrl ? "Live project" : "Open source"}</span>
          </div>

          <div class="project-card__copy">
            <h3>{project.title}</h3>
            <p class="project-card__description">{project.description}</p>
          </div>

          <div class="project-card__meta">
            <ul class="project-card__tags" aria-label={`${project.title} capabilities`}>
              {project.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
            </ul>

            {projectLink(project) && (
              <a
                class="project-action project-action--secondary"
                href={projectLink(project)}
                target="_blank"
                rel="noopener"
              >
                {projectAction(project)}
                <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .projects__container {
    max-width: 1120px;
  }

  .projects :global(.section-header) {
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .project-card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
    padding: clamp(1.15rem, 3vw, 1.75rem);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    color: var(--color-text);
    background: linear-gradient(180deg, var(--color-surface-elevated), var(--color-surface));
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.05),
      0 10px 28px rgba(15, 23, 42, 0.07);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .project-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--marvin-amber) 45%, var(--color-border));
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.05),
      0 16px 40px rgba(15, 23, 42, 0.1),
      0 0 0 1px var(--marvin-amber-soft);
  }

  :global([data-theme="dark"]) .project-card {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.05),
      0 1px 2px rgba(0, 0, 0, 0.4),
      0 12px 30px rgba(0, 0, 0, 0.35);
  }

  :global([data-theme="dark"]) .project-card:hover {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.05),
      0 1px 2px rgba(0, 0, 0, 0.4),
      0 18px 44px rgba(0, 0, 0, 0.45),
      0 0 0 1px var(--marvin-amber-soft);
  }

  /* The accent spine only wakes on hover, like the experience cards. */
  .project-card::after {
    position: absolute;
    z-index: -1;
    top: 0;
    bottom: 0;
    left: 0;
    width: 3px;
    border-radius: 14px 0 0 14px;
    background: var(--marvin-amber);
    opacity: 0;
    transition: opacity 0.3s ease;
    content: "";
  }

  .project-card:hover::after {
    opacity: 1;
  }

  /* The flagship build gets the Marvin stage treatment: a faint engineering
     grid, a warm amber wash, and the lab's corner brackets. */
  .project-card--featured {
    margin-bottom: 1rem;
    padding: clamp(1.35rem, 4vw, 2.25rem);
    background:
      linear-gradient(105deg, color-mix(in srgb, var(--marvin-amber) 7%, transparent), transparent 55%),
      linear-gradient(color-mix(in srgb, var(--color-stroke) 4%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--color-stroke) 4%, transparent) 1px, transparent 1px),
      linear-gradient(180deg, var(--color-surface-elevated), var(--color-surface));
    background-size: auto, 48px 48px, 48px 48px, auto;
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.06),
      0 20px 48px rgba(15, 23, 42, 0.1);
  }

  .project-card--featured::before,
  .project-card--featured::after {
    content: "";
    position: absolute;
    z-index: 1;
    width: 22px;
    height: 22px;
    border-color: var(--marvin-amber);
    border-style: solid;
    opacity: 0.75;
    pointer-events: none;
  }

  .project-card--featured::before {
    top: 12px;
    left: 12px;
    border-width: 1px 0 0 1px;
    border-radius: 0;
    background: none;
  }

  /* Featured trades the hover spine for the second corner bracket. */
  .project-card--featured::after {
    top: auto;
    left: auto;
    right: 12px;
    bottom: 12px;
    width: 22px;
    height: 22px;
    border-width: 0 1px 1px 0;
    border-radius: 0;
    background: none;
    opacity: 0.75;
  }

  .project-card--featured:hover::after {
    opacity: 1;
  }

  .project-card__marker {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--color-stroke-muted);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .project-card__marker span:first-child {
    color: var(--marvin-amber);
  }

  .project-card__body,
  .project-card__meta {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .project-card__copy {
    flex: 1;
    min-width: 0;
  }

  .project-card__eyebrow {
    margin-bottom: 0.55rem;
    color: var(--marvin-amber);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .project-card h3 {
    margin-bottom: 0.65rem;
    color: var(--color-text);
    font-family: var(--font-hand);
    font-size: clamp(1.35rem, 3vw, 1.85rem);
    font-weight: 700;
    line-height: 1.15;
  }

  .project-card--featured h3 {
    font-size: clamp(2rem, 5vw, 3.1rem);
  }

  .project-card__description {
    max-width: 60ch;
    color: var(--color-text-muted);
    font-size: clamp(0.94rem, 1.8vw, 1.05rem);
    line-height: 1.65;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .project-card__tags li {
    padding: 0.35rem 0.62rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-secondary);
    background: color-mix(in srgb, var(--color-bg) 80%, transparent);
    font-family: var(--font-mono);
    font-size: 0.69rem;
    line-height: 1.2;
    transition: border-color 150ms ease, color 150ms ease;
  }

  .project-card:hover .project-card__tags li {
    border-color: color-mix(in srgb, var(--marvin-amber) 30%, var(--color-border));
  }

  .project-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    gap: 0.55rem;
    min-height: 44px;
    padding: 0.68rem 0.95rem;
    border: 1px solid var(--color-border-hover);
    border-radius: 9px;
    color: var(--color-text);
    background: var(--color-bg);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.08);
    font-family: var(--font-ui);
    font-size: 0.88rem;
    font-weight: 750;
    line-height: 1;
    text-decoration: none;
    transition: transform 150ms ease, box-shadow 150ms ease, background-color 150ms ease, border-color 150ms ease;
  }

  .project-action:hover {
    color: #0d0d12;
    background: var(--marvin-amber);
    border-color: var(--marvin-amber);
    box-shadow: 0 4px 14px var(--marvin-amber-soft);
    text-decoration: none;
    transform: translateY(-1px);
  }

  .project-action:focus-visible {
    outline: 2px solid var(--marvin-amber);
    outline-offset: 4px;
  }

  .project-action--primary {
    color: #14181f;
    background: var(--marvin-amber);
    border-color: var(--marvin-amber);
  }

  .project-action--primary:hover {
    box-shadow: 0 6px 18px var(--marvin-amber-soft);
  }

  .project-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }

  .project-card--supporting .project-card__meta {
    margin-top: auto;
  }

  @media (min-width: 720px) {
    .project-card__body {
      display: grid;
      grid-template-columns: minmax(0, 1.55fr) minmax(15rem, 0.75fr);
      align-items: end;
      gap: 2rem;
    }

    .project-card--featured .project-card__meta {
      align-items: flex-start;
      padding-left: 1.5rem;
      border-left: 1px solid var(--color-stroke-muted);
    }

    .project-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .project-list {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .project-card--supporting {
      grid-column: span 7;
      min-height: 21rem;
    }

    .project-card--supporting:nth-child(2),
    .project-card--supporting:nth-child(3) {
      grid-column: span 5;
      min-height: 19rem;
    }

    .project-card--supporting:nth-child(4) {
      grid-column: span 7;
      min-height: 19rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-action {
      transition: none;
    }
  }
</style>

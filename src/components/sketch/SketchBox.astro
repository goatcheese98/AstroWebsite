---
interface Props {
  as?: string;
  fillColor?: string;
  class?: string;
}

const { as: Tag = 'div', fillColor, class: className } = Astro.props;
---

<Tag
  class:list={['sketch-box', className]}
  style={fillColor ? `--fill: ${fillColor}` : undefined}
>
  <slot />
</Tag>

<style>
  .sketch-box {
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: var(--space-md);
    background: var(--fill, linear-gradient(180deg, var(--color-surface-elevated), var(--color-surface)));
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.05),
      0 10px 28px rgba(15, 23, 42, 0.07);
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }

  :global([data-theme="dark"]) .sketch-box {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.05),
      0 1px 2px rgba(0, 0, 0, 0.4),
      0 12px 30px rgba(0, 0, 0, 0.35);
  }

  .sketch-box:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--marvin-amber) 45%, var(--color-border));
  }
</style>

---
interface Props {
  fillColor?: string;
  class?: string;
}

const { fillColor, class: className } = Astro.props;
---

<span
  class:list={['sketch-badge', className]}
  style={fillColor ? `--badge-fill: ${fillColor}` : undefined}
>
  <slot />
</span>

<style>
  .sketch-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.2;
    padding: 0.34rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--badge-fill, var(--color-bg));
    white-space: nowrap;
    color: var(--color-text-secondary);
  }
</style>

---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  size?: 'sm' | 'md';
  class?: string;
  [key: string]: any;
}

const { href, variant = 'primary', size = 'md', class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  class:list={['sketch-btn', `sketch-btn--${variant}`, `sketch-btn--${size}`, className]}
  {...rest}
>
  <slot />
</Tag>

<style>
  .sketch-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-ui);
    font-size: var(--text-base);
    font-weight: 700;
    text-decoration: none;
    border: 1px solid var(--color-border-hover);
    border-radius: 9px;
    cursor: pointer;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.08);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }

  .sketch-btn:hover {
    transform: translateY(-1px);
    border-color: var(--marvin-amber);
    box-shadow: 0 4px 14px var(--marvin-amber-soft);
    text-decoration: none;
  }

  .sketch-btn:active {
    transform: translate(0, 0);
    box-shadow: none;
  }

  .sketch-btn:focus-visible {
    outline: 2px solid var(--marvin-amber);
    outline-offset: 2px;
  }

  .sketch-btn--primary {
    background: var(--marvin-amber);
    border-color: var(--marvin-amber);
    color: #14181f;
  }

  .sketch-btn--secondary {
    background: var(--color-surface);
    color: var(--color-text);
  }

  .sketch-btn--md {
    padding: var(--space-sm) var(--space-md);
  }

  .sketch-btn--sm {
    padding: var(--space-xs) var(--space-sm);
    font-size: var(--text-sm);
  }

</style>

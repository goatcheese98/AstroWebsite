---
import ThemeToggle from "./ThemeToggle.astro";
import { NAV_LINKS } from "../../lib/constants";

const currentPath = Astro.url.pathname;
---

<header class="header">
  <nav class="header__nav container" aria-label="Main navigation">
    <a href="/" class="header__logo" aria-label="Rohan Jasani, home">
      <span class="header__logo-block">RJ</span>
    </a>

    <ul class="header__links" role="list">
      {NAV_LINKS.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              "header__link",
              {
                active:
                  currentPath === link.href ||
                  (link.href !== "/" && currentPath.startsWith(link.href)),
              },
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="header__actions">
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    z-index: 100;
    top: 0;
    left: 0;
    width: 100%;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-stroke-muted) 55%, transparent);
    background: color-mix(in srgb, var(--color-bg) 94%, transparent);
    box-shadow: 0 8px 22px -22px rgba(13, 13, 18, 0.5);
  }

  .header__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: var(--space-sm);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .header__logo {
    display: flex;
    position: relative;
    align-items: center;
    color: var(--color-text);
    font-family: var(--font-ui);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: transform 180ms ease;
  }

  .header__logo:hover {
    text-decoration: none;
    transform: translateY(-1px);
  }

  .header__logo-block {
    display: grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    border: 2px solid #0d0d12;
    border-radius: 0.38rem;
    color: #ffd600;
    background: #0d0d12;
    box-shadow: 2px 2px 0 rgba(13, 13, 18, 0.22);
    font-size: 0.9rem;
    font-weight: 800;
    line-height: 1;
  }

  .header__links {
    display: flex;
    gap: var(--space-xs);
    padding: var(--space-xs);
    border: 1px solid
      color-mix(in srgb, var(--color-stroke-muted) 70%, transparent);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .header__link {
    display: block;
    position: relative;
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    font-family: var(--font-hand);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: all 200ms ease;
  }

  .header__link:hover {
    color: var(--color-text);
    background: var(--color-bg);
    text-decoration: none;
  }

  .header__link.active {
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-fill-1) 74%, transparent);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .header__nav {
      padding-block: var(--space-xs);
    }

    .header__links {
      gap: 0;
    }

    .header__links li:nth-child(2),
    .header__links li:nth-child(4) {
      display: none;
    }

    .header__link {
      padding: var(--space-2xs) var(--space-xs);
      font-size: var(--text-xs);
    }

    .header__actions {
      gap: var(--space-xs);
    }
  }
</style>

---
import ThemeToggle from "./ThemeToggle.astro";
import { UserMenu } from "../auth/UserMenu";
import { NAV_LINKS, CANVAS_NAV_LINKS } from "../../lib/constants";

const currentPath = Astro.url.pathname;
const hostname = Astro.url.hostname;
const isCanvasOnly =
  hostname === "canvas.rohanjasani.com" || hostname.startsWith("canvas.");
const isPortfolioHome = currentPath === "/" && !isCanvasOnly;

const portfolioLinks = [
  { label: "Work", href: "#level-up" },
  { label: "Projects", href: "#selected-work" },
  { label: "Experience", href: "#experience" },
  { label: "Approach", href: "#approach" },
  { label: "Notes", href: "/blog" },
];

const links = isPortfolioHome
  ? portfolioLinks
  : isCanvasOnly
    ? CANVAS_NAV_LINKS
    : NAV_LINKS;
---

<header class:list={["header", { "header--portfolio": isPortfolioHome }]}>
  <nav
    class:list={["header__nav", { container: !isPortfolioHome, "header__nav--portfolio": isPortfolioHome }]}
    aria-label="Main navigation"
  >
    <a href="/" class="header__logo" aria-label="Rohan Jasani, home">
      {isPortfolioHome ? (
        <span class="header__wordmark"><strong>Rohan</strong><span>Jasani</span></span>
      ) : (
        <span class="header__logo-block">RJ</span>
      )}
    </a>

    <ul class:list={["header__links", { "header__links--portfolio": isPortfolioHome }]} role="list">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              "header__link",
              {
                active:
                  !isPortfolioHome &&
                  (currentPath === link.href ||
                    (link.href !== "/" && currentPath.startsWith(link.href))),
              },
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="header__actions">
      {!isPortfolioHome && <UserMenu client:only="react" />}
      {isPortfolioHome && <a class="header__contact" href="#contact">Contact</a>}
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    z-index: 100;
    top: 0;
    left: 0;
    width: 100%;
    border-bottom: 1px solid color-mix(in srgb, var(--color-stroke-muted) 55%, transparent);
    background: rgba(var(--color-bg-rgb), 0.72);
    backdrop-filter: blur(14px) saturate(130%);
    -webkit-backdrop-filter: blur(14px) saturate(130%);
  }

  .header--portfolio {
    border-color: rgba(18, 20, 23, 0.28);
    color: #121417;
    background: rgba(241, 238, 229, 0.92);
    font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  :global([data-theme="dark"]) .header--portfolio {
    border-color: rgba(243, 240, 231, 0.2);
    color: #f3f0e7;
    background: rgba(21, 24, 23, 0.92);
  }

  .header__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: var(--space-sm);
  }

  .header__nav--portfolio {
    width: min(100% - 2rem, 76rem);
    min-height: 4rem;
    margin-inline: auto;
  }

  .header__logo {
    display: flex;
    position: relative;
    align-items: center;
    color: var(--color-text);
    font-family: var(--font-ui);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    text-decoration: none;
  }

  .header--portfolio .header__logo,
  .header--portfolio .header__logo:hover {
    color: inherit;
  }

  .header__logo-block {
    display: grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    border: 2px solid #0d0d12;
    border-radius: 0.38rem;
    color: #ffd600;
    background: #0d0d12;
    box-shadow: 2px 2px 0 rgba(13, 13, 18, 0.22);
    font-size: 0.9rem;
    font-weight: 800;
    line-height: 1;
  }

  .header__wordmark {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
    font-size: 0.82rem;
    letter-spacing: -0.02em;
  }

  .header__wordmark strong {
    font-family: "Iowan Old Style", "Palatino Linotype", Georgia, serif;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .header__wordmark span {
    color: currentColor;
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .header__links {
    display: flex;
    gap: var(--space-xs);
    padding: var(--space-xs);
    border: 1px solid color-mix(in srgb, var(--color-stroke-muted) 70%, transparent);
    border-radius: var(--radius-lg);
    background: rgba(var(--color-bg-rgb), 0.5);
  }

  .header__links--portfolio {
    gap: 1.35rem;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .header__link {
    display: block;
    position: relative;
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    font-family: var(--font-hand);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .header__links--portfolio .header__link {
    padding: 0.35rem 0;
    border-radius: 0;
    color: inherit;
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .header__links--portfolio .header__link::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    content: "";
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 160ms ease;
  }

  .header__links--portfolio .header__link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .header__link.active {
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-fill-1) 74%, transparent);
    font-weight: 600;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .header__contact {
    padding: 0.55rem 0.8rem;
    border: 1px solid currentColor;
    color: inherit;
    background: #dbf44e;
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .header__contact:hover {
    color: #111;
  }

  @media (max-width: 820px) {
    .header__links--portfolio li:nth-child(4),
    .header__links--portfolio li:nth-child(5) {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .header__nav {
      padding-block: var(--space-xs);
    }

    .header__nav--portfolio {
      width: min(100% - 1.25rem, 76rem);
    }

    .header__links--portfolio {
      gap: 0.9rem;
    }

    .header__links--portfolio li:nth-child(3) {
      display: none;
    }

    .header__links--portfolio .header__link {
      font-size: 0.58rem;
    }

    .header__contact {
      display: none;
    }
  }

  @media (max-width: 390px) {
    .header__links--portfolio li:nth-child(2) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header__links--portfolio .header__link::after {
      transition: none;
    }
  }
</style>

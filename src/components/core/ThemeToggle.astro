---
---
<div class="theme-toggle-wrap">
  <button
    class="theme-toggle"
    aria-label="Toggle dark mode"
    title="Toggle dark mode"
    type="button"
  >
    <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="12" cy="12" r="5" />
      <line x1="12" y1="1" x2="12" y2="3" />
      <line x1="12" y1="21" x2="12" y2="23" />
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
      <line x1="1" y1="12" x2="3" y2="12" />
      <line x1="21" y1="12" x2="23" y2="12" />
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
    </svg>
    <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
    </svg>
  </button>
</div>

<style>
  .theme-toggle-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .theme-toggle {
    box-sizing: border-box;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    color: var(--color-text);
    cursor: pointer;
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06);
  }

  .theme-toggle:hover {
    border-color: color-mix(in srgb, var(--marvin-amber) 55%, var(--color-border));
    box-shadow: 0 2px 10px var(--marvin-amber-soft);
    transform: translateY(-1px);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--marvin-amber);
    outline-offset: 2px;
  }

  :global([data-theme-forced="light"]) .theme-toggle-wrap {
    display: none;
  }

  [data-theme="light"] .icon-sun { display: none; }
  [data-theme="light"] .icon-moon { display: block; }
  [data-theme="dark"] .icon-sun { display: block; }
  [data-theme="dark"] .icon-moon { display: none; }
</style>

<script is:inline>
  (function() {
    function initThemeToggle() {
      var toggleWrap = document.querySelector(".theme-toggle-wrap");
      if (!toggleWrap) return;

      var themeToggle = toggleWrap.querySelector(".theme-toggle");
      if (!themeToggle) return;

      if (themeToggle.dataset.initialized === "true") return;
      themeToggle.dataset.initialized = "true";

      var hostname = window.location.hostname;
      if (hostname.includes("canvas.")) {
        toggleWrap.style.display = "none";
        return;
      }

      function onThemeToggleClick(event) {
        var html = document.documentElement;
        var current = html.getAttribute("data-theme");
        var next = current === "dark" ? "light" : "dark";
        html.setAttribute("data-theme", next);
        localStorage.setItem("theme", next);

        var ripple = document.createElement("span");
        ripple.className = "theme-page-ripple";
        ripple.style.left = event.clientX + "px";
        ripple.style.top = event.clientY + "px";
        document.body.appendChild(ripple);
        setTimeout(function() {
          ripple.remove();
        }, 1000);
      }

      themeToggle.addEventListener("click", onThemeToggleClick);

      (window.__themeToggleCleanup || function() {})();
      window.__themeToggleCleanup = function() {
        themeToggle.removeEventListener("click", onThemeToggleClick);
      };
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initThemeToggle);
    } else {
      initThemeToggle();
    }

    document.addEventListener("astro:page-load", initThemeToggle);
    document.addEventListener("astro:before-swap", function() {
      if (window.__themeToggleCleanup) window.__themeToggleCleanup();
    });
  })();
</script>

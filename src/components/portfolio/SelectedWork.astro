---
import { SELECTED_WORK } from "../../lib/portfolio-content";
---

<section class="dossier-section dossier-work" id="selected-work" aria-labelledby="work-title">
  <div class="dossier-shell">
    <header class="dossier-section__header">
      <div>
        <p class="dossier-kicker">03 · Selected work</p>
        <h2 id="work-title">Different surfaces. The same instinct to make complexity usable.</h2>
      </div>
      <p class="dossier-section__lede">
        Products, experiments, and analytical systems that show how I learn:
        build a real thing, put it in front of people, and follow the evidence.
      </p>
    </header>

    <div class="work-index">
      {SELECTED_WORK.map((project, index) => (
        <a
          class={`work-file work-file--${project.accent}`}
          href={project.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          <div class="work-file__topline">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <span>{project.label}</span>
            <span aria-hidden="true">↗</span>
          </div>
          <div class="work-file__body">
            <h3>{project.title}</h3>
            <p>{project.description}</p>
          </div>
          <p class="work-file__proof">{project.proof}</p>
          <ul aria-label={`${project.title} themes`}>
            {project.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        </a>
      ))}
    </div>
  </div>
</section>

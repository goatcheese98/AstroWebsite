---
import { OPERATING_APPROACH } from "../../lib/portfolio-content";
---

<section class="dossier-section dossier-approach" id="approach" aria-labelledby="approach-title">
  <div class="dossier-shell">
    <header class="dossier-section__header">
      <div>
        <p class="dossier-kicker">02 · Operating approach</p>
        <h2 id="approach-title">The software is only part of the intervention.</h2>
      </div>
      <p class="dossier-section__lede">
        My edge is closing the loop between a business problem and a system that
        changes how the work actually happens.
      </p>
    </header>

    <ol class="approach-sequence">
      {OPERATING_APPROACH.map((step) => (
        <li>
          <span>{step.number}</span>
          <div>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

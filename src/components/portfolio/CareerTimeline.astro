---
import { CAREER } from "../../lib/portfolio-content";
---

<section class="dossier-section dossier-career" id="experience" aria-labelledby="career-title">
  <div class="dossier-shell">
    <header class="dossier-section__header">
      <div>
        <p class="dossier-kicker">04 · Career arc</p>
        <h2 id="career-title">Business foundations. Increasingly technical execution.</h2>
      </div>
      <p class="dossier-section__lede">
        My path runs through regulated operations, analytics, product judgment,
        and now the hands-on construction of AI-enabled business systems.
      </p>
    </header>

    <ol class="career-record">
      {CAREER.map((item, index) => (
        <li>
          <div class="career-record__index">
            <span>{String(index + 1).padStart(2, "0")}</span>
            {item.current && <small>Current</small>}
          </div>
          <div class="career-record__title">
            <p>{item.organization}</p>
            <h3>{item.role}</h3>
          </div>
          <div class="career-record__detail">
            <p class="career-record__scope">{item.scope}</p>
            <p>{item.description}</p>
          </div>
          <time>{item.period}</time>
        </li>
      ))}
    </ol>
  </div>
</section>
